# bash setup/00_configure_env.sh creates .env from this file (never commit .env).

# ---------- MariaDB, single instance on this EC2 host (structured ERP) ----------
# setup/00_configure_env.sh generates this password; setup/05_create_mariadb_rag_access.sh creates the
# SELECT-only user with it.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
# Optional: connect through the Unix socket instead of TCP (overrides host/port), e.g.
# MARIADB_SOCKET=/run/mysqld/mysqld.sock
MARIADB_SOCKET=
MARIADB_USER=gigavolt_rag
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=gigavolt_silver

# ---------- MongoDB (IoT telemetry document store) ----------
MONGO_URI=mongodb://127.0.0.1:27017/?appName=gigavolt-rag
MONGO_DB=gigavolt_iot
MONGO_COLLECTION=bms_telemetry

# ---------- ChromaDB vector store (built by scripts/00_build_vector_store.py) ----------
# Relative paths are resolved from the Milestone_5 folder.
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=gigavolt_unstructured_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MANIFEST=data/processed/embedding_manifest.json

# ---------- LLM (free options first) ----------
# groq | ollama | anthropic | openai | extractive   (setup/00_configure_env.sh fills this in)
#   groq      : free tier, fast (meets the <5 s target). Free key: https://console.groq.com/keys
#   ollama    : local model on this EC2 instance, no key at all; slower on CPU
#   extractive: no LLM call, quotes the cited evidence
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=20
# Batch scripts (04/05) wait this long between LLM calls; empty = 30 s for groq, 0 otherwise.
LLM_MIN_INTERVAL_S=

# ---------- Retrieval tuning ----------
VECTOR_TOP_K=5
VECTOR_MAX_DISTANCE=0.80
SQL_ROW_LIMIT=10
MONGO_EVENT_LIMIT=6
HIGH_TEMP_THRESHOLD_C=45
LATENCY_TARGET_S=5
