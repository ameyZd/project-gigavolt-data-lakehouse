# Copy to .env (never commit .env):   cp .env.example .env   then edit the values.

# ---------- MariaDB, single instance on this EC2 host (structured ERP) ----------
# setup/03_create_mariadb_rag_access.sh creates this SELECT-only user with this password.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
# Optional: connect through the Unix socket instead of TCP (overrides host/port), e.g.
# MARIADB_SOCKET=/run/mysqld/mysqld.sock
MARIADB_SOCKET=
MARIADB_USER=gigavolt_rag
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=gigavolt_silver

# ---------- MongoDB (IoT telemetry document store) ----------
MONGO_URI=mongodb://127.0.0.1:27017/?appName=gigavolt-rag
MONGO_DB=gigavolt_iot
MONGO_COLLECTION=bms_telemetry

# ---------- ChromaDB (Milestone 4 vector store) ----------
# Relative paths are resolved from the Milestone_5 folder.
CHROMA_PATH=../Milestone_4/data/chroma_db
CHROMA_COLLECTION=gigavolt_unstructured_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MANIFEST=../Milestone_4/data/processed/embedding_manifest.json

# ---------- LLM ----------
# anthropic | openai | ollama | extractive   (extractive = no LLM call, quotes cited evidence)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=20

# ---------- Retrieval tuning ----------
VECTOR_TOP_K=5
VECTOR_MAX_DISTANCE=0.80
SQL_ROW_LIMIT=10
MONGO_EVENT_LIMIT=6
HIGH_TEMP_THRESHOLD_C=45
LATENCY_TARGET_S=5
