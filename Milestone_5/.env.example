# Copy to .env (setup.sh does this for you) and paste your free Groq key.
# Get one at https://console.groq.com/keys  (free, no credit card)

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Fully local alternative (slower on t3.medium): install Ollama, then
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2:3b   LLM_API_KEY=ollama

# --- MariaDB (ERP, read-only RAG user created by sql/rag_setup.sql) ---
MARIADB_HOST=localhost
MARIADB_USER=rag_reader
MARIADB_PASSWORD=gigavolt_rag_readonly
MARIADB_DB=gigavolt_silver

# --- MongoDB (IoT telemetry, started by config/docker-compose.yml) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gigavolt
MONGO_COLLECTION=telemetry

# --- ChromaDB (technical manuals) ---
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=gigavolt_docs
